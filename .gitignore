# Kernel traces are released on Zenodo, not tracked in git (see DATA.md).
# This keeps the repo small and stops a Zenodo download from being committed.
**/trace/
**/*.txt.gz

# Python
__pycache__/
*.pyc
*.pyo

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
research-paper/*.pdf

# OS / editor junk
.DS_Store
Thumbs.db
*.swp

.idea

# Downloaded trace archive and reference PDFs
zenodo-traces/
/*.pdf

# Large intermediate files, rebuilt by phase2/run_passes.py and phase1 scripts
**/parsed_all.jsonl
**/local_all.jsonl

.venv/
paper-icpe/main.pdf
paper-icpe/build.log
paper-icpe/*.log
paper-icpe/*.fdb_latexmk
